{
  "name": "meow-comment-ui",
  "version": "1.0.1",
  "description": "A lightweight comment editor for Meow Comment",
  "type": "module",
  "main": "./dist/MeowCommentUI.js",
  "module": "./dist/MeowCommentUI.mjs",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/MeowCommentUI.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/MeowCommentUI.cjs"
      }
    },
    "./MeowCommentUI.css": "./dist/MeowCommentUI.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "25.9.5",
    "cross-env": "10.1.0",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "sass": "1.101.3",
    "terser": "5.49.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
